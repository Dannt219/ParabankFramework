<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Cross-browser parallel smoke run.
    Use this for local cross-browser validation, NOT for CI against shared demo servers
    (ParaBank's free demo cannot reliably serve two concurrent sessions of the same user).

    Run with: mvn test -Dsurefire.suiteXmlFiles=src/test/resources/testng-crossbrowser.xml
-->
<suite name="ParaBank Cross-Browser Smoke Suite" parallel="tests" thread-count="2">

    <test name="Chrome Smoke Tests">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.parabank.tests"/>
        </packages>
    </test>

    <test name="Firefox Smoke Tests">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.parabank.tests"/>
        </packages>
    </test>

</suite>
